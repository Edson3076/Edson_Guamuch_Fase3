<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto.GestionCitasExpedientes.vista.ControladorCitas">
   <children>
      <!-- BARRA DE FILTROS -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card" style="-fx-padding: 10 16;">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Filtrar Citas:" />
            <DatePicker fx:id="dpFiltroFecha" prefWidth="140.0" promptText="Por Fecha" />
            <ComboBox fx:id="cmbFiltroMedico" prefWidth="180.0" promptText="Por Médico" />
            <ComboBox fx:id="cmbFiltroEstado" prefWidth="140.0" promptText="Por Estado" />
            <Button onAction="#handleLimpiarFiltros" styleClass="btn-secondary" text="Limpiar Filtros" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#recargarCitas" styleClass="btn-secondary" text="🔄 Refrescar" />
         </children>
      </HBox>
      
      <!-- CUERPO PRINCIPAL: TABLA DE CITAS Y PROGRAMACIÓN -->
      <HBox spacing="14.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Tabla de Citas y Acciones -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox>
                           <children>
                              <Label styleClass="card-title" text="Agenda Médica de Citas" />
                              <Label styleClass="card-subtitle" text="Seleccione una cita para confirmarla, cancelarla o atender consulta" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblConteoCitas" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Total citas: 0" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                        <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
                        <TableColumn fx:id="colHora" prefWidth="70.0" text="Hora" />
                        <TableColumn fx:id="colPaciente" prefWidth="150.0" text="Paciente" />
                        <TableColumn fx:id="colMedico" prefWidth="150.0" text="Médico" />
                        <TableColumn fx:id="colEspecialidad" prefWidth="120.0" text="Especialidad" />
                        <TableColumn fx:id="colCosto" prefWidth="75.0" text="Costo" />
                        <TableColumn fx:id="colEstado" prefWidth="105.0" text="Estado" />
                        <TableColumn fx:id="colMotivo" prefWidth="160.0" text="Motivo Cancelación" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <!-- Barra de Acciones sobre la Cita Seleccionada -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 8 12; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Acciones para cita seleccionada:" />
                        <Button fx:id="btnConfirmar" onAction="#handleConfirmarCita" styleClass="btn-success" text="✓ Confirmar" />
                        <Button fx:id="btnCancelar" onAction="#handleCancelarCita" styleClass="btn-danger" text="✗ Cancelar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAtenderConsulta" onAction="#handleAtenderConsulta" styleClass="btn-primary" text="🩺 Atender en Consulta →" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Formulario de Programación de Cita -->
            <VBox prefWidth="400.0" spacing="10.0" styleClass="card" HBox.hgrow="NEVER">
               <children>
                  <Label styleClass="card-title" text="Programar Nueva Cita" />
                  <Label styleClass="card-subtitle" text="" /> <!-- Validación de horario y asignación de costos según especialidad-->
                  
                  <Separator />
                  
                  <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <!-- Selector Paciente -->
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="form-label" text="Seleccionar Paciente (*):" />
                              <ComboBox fx:id="cmbPaciente" maxWidth="1.7976931348623157E308" promptText="Buscar paciente" />
                           </children>
                        </VBox>
                        
                        <!-- Selector Médico -->
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="form-label" text="Seleccionar Médico (*):" />
                              <ComboBox fx:id="cmbMedico" maxWidth="1.7976931348623157E308" promptText="Elegir médico" />
                           </children>
                        </VBox>
                        
                        <!-- Resumen Especialidad y Horario -->
                        <VBox spacing="4.0" style="-fx-background-color: #f0f9ff; -fx-padding: 8 12; -fx-background-radius: 6; -fx-border-color: #bae6fd; -fx-border-radius: 6;">
                           <children>
                              <HBox>
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #0369a1;" text="Especialidad: " />
                                    <Label fx:id="lblEspecialidadInfo" style="-fx-text-fill: #0c4a6e;" text="Seleccione un médico" />
                                 </children>
                              </HBox>
                              <HBox>
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #0369a1;" text="Costo Consulta: " />
                                    <Label fx:id="lblCostoInfo" style="-fx-font-weight: bold; -fx-text-fill: #0284c7;" text="Q0.00" />
                                 </children>
                              </HBox>
                              <Label fx:id="lblHorarioMedicoInfo" style="-fx-font-size: 11px; -fx-text-fill: #0284c7;" text="Horario de atención: -" />
                           </children>
                        </VBox>
                        
                        <!-- Fecha y Hora -->
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-label" text="Fecha (*):" />
                                    <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-label" text="Hora (*):" />
                                    <ComboBox fx:id="cmbHora" maxWidth="1.7976931348623157E308" promptText="09:00" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <Separator />
                  
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#handleLimpiarFormulario" styleClass="btn-secondary" text="Limpiar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleProgramarCita" styleClass="btn-primary" text="📅 Programar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
