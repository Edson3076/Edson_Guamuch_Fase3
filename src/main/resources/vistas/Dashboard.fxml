<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto.GestionCitasExpedientes.vista.ControladorDashboard">
   <children>
      <!-- FILA DE 4 TARJETAS DE MÉTRICAS -->
      <HBox spacing="14.0">
         <children>
            <!-- Métrica 1: Pacientes -->
            <VBox styleClass="metric-card-1" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="metric-label" text="PACIENTES" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px;" text="👥" />
                     </children>
                  </HBox>
                  <Label fx:id="lblTotalPacientes" styleClass="metric-value" text="0" />
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #bae6fd;" text="Expedientes clínicos registrados" />
               </children>
            </VBox>
            
            <!-- Métrica 2: Médicos -->
            <VBox styleClass="metric-card-2" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="metric-label" text="MÉDICOS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px;" text="👨‍⚕️" />
                     </children>
                  </HBox>
                  <Label fx:id="lblTotalMedicos" styleClass="metric-value" text="0" />
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #99f6e4;" text="Especialistas" />
               </children>
            </VBox>
            
            <!-- Métrica 3: Citas -->
            <VBox styleClass="metric-card-3" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="metric-label" text="CITAS EN AGENDA" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px;" text="📅" />
                     </children>
                  </HBox>
                  <Label fx:id="lblTotalCitas" styleClass="metric-value" text="0" />
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #c7d2fe;" text="Programadas y activas" />
               </children>
            </VBox>
            
            <!-- Métrica 4: Consultas -->
            <VBox styleClass="metric-card-4" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="metric-label" text="CONSULTAS ATENDIDAS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px;" text="🩺" />
                     </children>
                  </HBox>
                  <Label fx:id="lblTotalConsultas" styleClass="metric-value" text="0" />
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #a7f3d0;" text="Historial clínico" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- SECCIÓN INFERIOR: PRÓXIMAS CITAS Y ACCIONES RÁPIDAS -->
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Tabla de Próximas Citas -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox>
                           <children>
                              <Label styleClass="card-title" text="Próximas Citas Médicas del Sistema" />
                              <Label styleClass="card-subtitle" text="Seguimiento de citas" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#actualizarDashboard" styleClass="btn-secondary" text="🔄 Refrescar" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tblCitasRecientes" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCitaId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colCitaFecha" prefWidth="100.0" text="Fecha" />
                        <TableColumn fx:id="colCitaHora" prefWidth="75.0" text="Hora" />
                        <TableColumn fx:id="colCitaPaciente" prefWidth="160.0" text="Paciente" />
                        <TableColumn fx:id="colCitaMedico" prefWidth="160.0" text="Médico" />
                        <TableColumn fx:id="colCitaEspecialidad" prefWidth="130.0" text="Especialidad" />
                        <TableColumn fx:id="colCitaEstado" prefWidth="110.0" text="Estado" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            
            <!-- Panel Lateral de Acciones Rápidas -->
            <VBox prefWidth="320.0" spacing="14.0" styleClass="card" HBox.hgrow="NEVER">
               <children><!--
                  <Label styleClass="card-title" text="Acciones Rápidas" />
                  <Label styleClass="card-subtitle" text="Accesos directos a los módulos" />
                  
                  <VBox spacing="10.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#irACitas" styleClass="btn-primary" style="-fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="📅  Agendar Nueva Cita" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#irAPacientes" styleClass="btn-secondary" style="-fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="👥  Registrar Nuevo Paciente" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#irAConsultas" styleClass="btn-secondary" style="-fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="🩺  Registrar Consulta Médica" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#irAMedicos" styleClass="btn-secondary" style="-fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="👨‍⚕️  Ver Directorio Médico" />
                     </children>
                  </VBox>
                  
                  <Separator />
                  -->
                  <Label styleClass="card-title" text="Costo    Especialidades" />
                  <VBox fx:id="contenedorEspecialidadesResumen" spacing="6.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
